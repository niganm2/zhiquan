<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 引入 Spring Boot 默认日志定义（含 %clr 彩色转换符与默认格式） -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 日志文件存放目录（项目根目录下的 logs） -->
    <property name="LOG_HOME" value="D:/JAVA/code/zhiquan/logs"/>

    <!--
      控制台：直接使用 Spring Boot 自带的 CONSOLE appender
      default 格式按级别着色：ERROR 红 / WARN 黄 / INFO 蓝 / DEBUG 灰，类名带跳转链接
    -->
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- 文件格式：纯文本，不能带 ANSI 颜色码，否则日志文件里全是控制符 -->
    <property name="FILE_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- 按天滚动的文件输出 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/zhiquan-user.%d{yyyy-MM-dd}.log</fileNamePattern>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>utf8</charset>
        </encoder>
    </appender>

    <!-- 异步写文件：不阻塞业务线程，队列满也不丢日志 -->
    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <discardingThreshold>0</discardingThreshold>
        <queueSize>512</queueSize>
        <appender-ref ref="FILE"/>
    </appender>

    <!-- 业务包日志级别 -->
    <logger name="com.yule" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC"/>
    </root>
</configuration>
